<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="IconesDlg">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="ChampBase" TargetType="Control">
    <Setter Property="Foreground" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="Background" Value="{DynamicResource DlgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DlgBordure}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource ChampBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource DlgAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgTexteDoux}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
              <Setter TargetName="Cadre" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Cadre" Property="Padding" Value="9,7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource ChampBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource DlgAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgTexteDoux}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
              <Setter TargetName="Cadre" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Cadre" Property="Padding" Value="9,7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="Background" Value="{DynamicResource DlgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DlgBordure}"/>
    <Setter Property="Padding" Value="18,8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fond" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fond" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{DynamicResource DlgAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="BoutonFermer" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource DlgTexteDoux}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fond" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fond" Property="Background" Value="#E81123"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Ligne" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Case" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                      BorderBrush="{DynamicResource DlgTexteDoux}" Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="Coche" Text="&#xE73E;" FontFamily="{StaticResource IconesDlg}" FontSize="12"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ligne" Property="Background" Value="{DynamicResource DlgSurvol}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Case" Property="Background" Value="{DynamicResource DlgAccent}"/>
              <Setter TargetName="Case" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
              <Setter TargetName="Coche" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource DlgTexte}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fond" Background="Transparent" CornerRadius="6" Padding="10,7">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fond" Property="Background" Value="{DynamicResource DlgSurvol}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource DlgAccent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource ChampBase}">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Bascule" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Cadre" Background="{DynamicResource DlgSurface}" BorderBrush="{DynamicResource DlgBordure}"
                          BorderThickness="1" CornerRadius="8">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconesDlg}" FontSize="11" Foreground="{DynamicResource DlgTexteDoux}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgTexteDoux}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,8,34,8" IsHitTestVisible="False" VerticalAlignment="Center"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource DlgSurface}" BorderBrush="{DynamicResource DlgBordure}" BorderThickness="1"
                      CornerRadius="8" Padding="4" Margin="0,4,8,8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <ScrollViewer>
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource DlgBordure}" CornerRadius="4" Margin="1,2"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
